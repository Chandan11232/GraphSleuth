# FalkorDB (docker compose sets these for the backend container)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# true if your FalkorDB Cloud instance requires TLS
FALKORDB_SSL=false

# LLM: "ollama" or "none" (graph-only investigations, no LLM needed)
LLM_PROVIDER=ollama
# Use 127.0.0.1 rather than localhost when running the backend directly on macOS,
# so it reaches the native (GPU) Ollama rather than an IPv6-bound container.
OLLAMA_HOST=http://127.0.0.1:11434
# Set for Ollama Cloud (OLLAMA_HOST=https://ollama.com)
OLLAMA_API_KEY=
# Drives the tool-calling loop; must support tools (qwen2.5-coder, qwen2.5, llama3.1, llama3.2...).
# If it is missing, the first installed tool-capable model is used.
OLLAMA_AGENT_MODEL=qwen2.5-coder:7b
# Writes the patch. Using the same model as above means only one model is ever in RAM.
OLLAMA_MODEL=qwen2.5-coder:7b
# How long Ollama keeps the model loaded after a request (frees RAM between investigations)
OLLAMA_KEEP_ALIVE=1m

# Optional: default token for private GitHub repos, and for opening pull requests for verified fixes
GITHUB_TOKEN=

# Fix verification runs a repository's tests in a sandbox copy: "local" (only repos connected from a server
# directory, the safe default), "all" (also GitHub repos: run the API in a disposable container), or "off"
VERIFY_FIXES=local
VERIFY_TIMEOUT_SECONDS=60

# Public deployments: only allow connecting server-side repos under this directory (e.g. /demo)
LOCAL_REPOS_ROOT=
# Browser origins allowed to call the API (your frontend URL)
CORS_ORIGINS=http://localhost:3000
